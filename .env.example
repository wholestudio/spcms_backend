# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Prisma)
# Schema changes must be applied with `npx prisma migrate dev` / `npx prisma migrate deploy`.
# The application never auto-syncs the database schema on startup.
# App runtime — for Neon use the pooled host (-pooler) with pgbouncer=true
DATABASE_URL=postgresql://spcms:spcms@localhost:5432/spcms?schema=public
# Prisma migrate / seed — for Neon use the direct (non-pooler) host; locally can match DATABASE_URL
DIRECT_URL=postgresql://spcms:spcms@localhost:5432/spcms?schema=public

# JWT — used for the httpOnly `spcms_session` cookie and Bearer tokens
# Use a long, random secret in every environment. Minimum 32 characters in production.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Auth lockout / token TTLs
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Session cookies
# COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
# COOKIE_SECURE defaults to true in production; set explicitly if needed
# COOKIE_SECURE=false

# Local CMS staff login / seed (not a production identity store).
# Copy these into `.env`. Change the password before sharing a machine.
BOOTSTRAP_ADMIN_EMAIL=admin@studiopatron.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin1!
BOOTSTRAP_ADMIN_NAME=Studio Patron Admin

# CORS (comma-separated origins — never use * in production)
# Local: spcms_frontend on :3000, studiopatron_app on :3001
# Include :4000 so Swagger UI on the API itself can call endpoints
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Swagger / OpenAPI UI at /api/docs (disable in locked-down production if required)
SWAGGER_ENABLED=true

# Rate limiting (in-memory; swap to Redis later if needed)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Cloudinary (Media Upload API — required for /api/v1/media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Future integrations (do not hardcode real credentials) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
