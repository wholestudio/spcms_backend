# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000

# PostgreSQL (Prisma)
# Schema changes must be applied with `npx prisma migrate dev` / `npx prisma migrate deploy`.
# The application never auto-syncs the database schema on startup.
DATABASE_URL=postgresql://spcms:spcms@localhost:5432/spcms?schema=public

# JWT (foundation only — auth flows are not implemented yet)
# Use a long, random secret in every environment. Minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# CORS (comma-separated origins — never use * in production)
# Local: studiopatron_app, spcms_frontend
# Staging/production: set explicit frontend and CMS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Swagger / OpenAPI UI at /api/docs (disable in locked-down production if required)
SWAGGER_ENABLED=true

# Rate limiting (in-memory; swap to Redis later if needed)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Future integrations (do not hardcode real credentials) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
